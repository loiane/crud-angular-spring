{
  "consumer": {
    "name": "crud-angular"
  },
  "interactions": [
    {
      "description": "a request for the first page of courses",
      "providerStates": [
        {
          "name": "three courses exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/courses",
        "query": {
          "page": [
            "0"
          ],
          "pageSize": [
            "10"
          ]
        }
      },
      "response": {
        "body": {
          "courses": [
            {
              "_id": 1,
              "category": "Front-end",
              "name": "Angular"
            }
          ],
          "totalElements": 3,
          "totalPages": 1
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.courses": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.courses[*]._id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.courses[*].category": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.courses[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.totalElements": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.totalPages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.0.1"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "crud-spring"
  }
}